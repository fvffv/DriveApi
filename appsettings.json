{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Watch.BrowserRefresh": "Warning"
      }
    }
  },
  "JwtConfig": {
    "SigningKey": "",
    "ExpireSeconds": 604800,
    "Issuer": "drive-api",
    "Audience": "drive-api"
  },
  "FileConfig": {
    "MaxFileSize": 53687091200,
    "IsSoftDelete": false,
    "LocalFilePath": "",
    "FileOrDirNameLengthLimit": 255,
    "FileOrDirNameBlacklist": "",
    "FileOrDirNameBlacklistRegExp": "",
    "TempFilePath": "",
    "FileChunkSizeBytes": 4194304,
    "CleanupChunkFilesWorkerTimeOutSecond": 259200,
    "CleanupChunkFilesWorkerLoopTimeSecond": 600
  },
  "DbConfig": {
    "DbType": 4,
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=drive;Username=postgres;Password=123456;",
    "LogWriteToDB": true,
    "CreateAdminUser": false
  },
  "CacheConfig": {
    "CacheType": "MemoryCache",
    "ConnectionString": "127.0.0.1:6379",
    "ValidityPeriod": 7,
    "TempDownLoadKeyValidityPeriod": 2
  },
  "UserConfig": {
    "UserNameMaxLength": 50,
    "UserPassWordMinLength": 6,
    "UserPassWordMaxLength": 18,
    "DefaultUserAvatar": "https://example.com/default-avatar.png",
    "DefaultTotalStorageGb": 100
  },
  "EmailConfig": {
    "SmtpServer": "smtp.163.com",
    "SmtpPort": 465,
    "Email": "",
    "PassWord": ""
  },
  "BasicInformation": {
    "ProjectName": "居家网盘"
  },
  "MQConfig": {
    "MqType": "MemoryMQ",
    "ConnectionString": "localhost:5672"
  },
  "AIConfig": {
    "Enable": true,
    "ImageCosineThreshold": 0.25,
    "TextCosineThreshold": 0.4,
    "TextGapRatio": 2.7,
    "BaseURL": "https://api.deepseek.com",
    "ApiKey": "",
    "Model": "deepseek-v4-flash",
    "IsIncomplete": false
  },
  "ServerSettings": {
    "IPv4": {
      "Ip": "127.0.0.1",
      "Port": 5085,
      "EnableSsl": true,
      "CertPath": "certs/v4.pfx",
      "CertPassword": "your_password"
    },
    "IPv6": {
      "Ip": "[::1]",
      "Port": 5846,
      "EnableSsl": false,
      "CertPath": "",
      "CertPassword": ""
    }
  }
}